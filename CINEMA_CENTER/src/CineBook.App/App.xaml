<Application x:Class="CineBook.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CineBook.Converters"
             xmlns:vm="clr-namespace:CineBook.ViewModels"
             xmlns:views="clr-namespace:CineBook.Views">
    <!-- Không dùng StartupUri: cửa sổ được tạo qua DI trong App.xaml.cs -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/FormStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converter dùng chung -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
            <conv:InverseBoolConverter x:Key="InvBool" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <conv:NullToVisibleConverter x:Key="NullToVisible" />
            <conv:EqualsConverter x:Key="Equals" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:MoneyConverter x:Key="Money" />
            <conv:AgeRatingBrushConverter x:Key="AgeBrush" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:PosterBrushConverter x:Key="PosterBrush" />
            <conv:BackdropBrushConverter x:Key="BackdropBrush" />
            <conv:StringNotEmptyConverter x:Key="NotEmpty" />
            <conv:StepVisibilityConverter x:Key="StepVis" />
            <conv:FirstLetterConverter x:Key="FirstLetter" />
            <conv:ShowtimeSelectedConverter x:Key="ShowtimeSelected" />

            <!-- Map ViewModel → View. Mỗi giai đoạn bổ sung thêm DataTemplate ở đây. -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AuthViewModel}"><views:AuthView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MyTicketsViewModel}"><views:MyTicketsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountViewModel}"><views:AccountView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:BookingViewModel}"><views:BookingView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CategoriesViewModel}"><views:CategoriesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CinemasViewModel}"><views:CinemasView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:MovieDetailViewModel}"><views:MovieDetailView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
