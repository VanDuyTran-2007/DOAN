<Window x:Class="CineBook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctl="clr-namespace:CineBook.Controls"
        Title="CineBook" Width="1366" Height="800" MinWidth="1280" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource NavyDarkest}"
        FontFamily="{StaticResource AppFont}">

    <!-- Bỏ title bar mặc định, tự vẽ bằng WindowChrome -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="{StaticResource NavyDarkest}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar tối màu -->
        <Grid Grid.Row="0" Background="{StaticResource NavyDarkest}">
            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                <Path Data="{StaticResource IconTicket}" Fill="{StaticResource Burgundy}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                <TextBlock Text="CineBook" Style="{StaticResource TextCaption}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Width="46" Height="36" Style="{StaticResource GhostButton}" Padding="0" Click="OnMinimize">
                    <Path Data="{StaticResource IconMinimize}" Fill="{StaticResource TextSecondary}" Width="14" Height="14" Stretch="Uniform" />
                </Button>
                <Button Width="46" Height="36" Style="{StaticResource GhostButton}" Padding="0" Click="OnMaximize">
                    <Path Data="{StaticResource IconMaximize}" Fill="{StaticResource TextSecondary}" Width="12" Height="12" Stretch="Uniform" />
                </Button>
                <Button Width="46" Height="36" Style="{StaticResource CloseCaptionButton}" Click="OnClose">
                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextPrimary}" Width="14" Height="14" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Header (ẩn ở trang Đăng nhập/Đăng ký) -->
        <ctl:HeaderView Grid.Row="1" DataContext="{Binding Header}"
                        Visibility="{Binding DataContext.IsHeaderVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

        <!-- Vùng nội dung điều hướng -->
        <ctl:TransitionContentControl Grid.Row="2" Content="{Binding Current}" />

        <!-- Toast phủ lên toàn bộ -->
        <ctl:ToastHost Grid.Row="1" Grid.RowSpan="2" DataContext="{Binding Toast}" />
    </Grid>
</Window>
