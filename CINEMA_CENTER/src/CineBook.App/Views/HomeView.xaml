<UserControl x:Class="CineBook.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CineBook.Controls"
             x:Name="Root">
    <!-- DataContext = HomeViewModel. Trang cuộn dọc: Hero → Đang chiếu → HOT → Sắp chiếu → Rạp gần bạn -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ctl:HeroBanner />

            <ctl:MovieShelf Title="Phim đang chiếu" Section="{Binding NowShowing}"
                            OpenCommand="{Binding OpenMovieCommand}" RetryCommand="{Binding RetryNowShowingCommand}" />

            <ctl:MovieShelf Title="Phim HOT" Section="{Binding Hot}"
                            OpenCommand="{Binding OpenMovieCommand}" RetryCommand="{Binding RetryHotCommand}" />

            <ctl:MovieShelf Title="Phim sắp chiếu" Section="{Binding ComingSoon}"
                            OpenCommand="{Binding OpenMovieCommand}" RemindCommand="{Binding RemindCommand}"
                            RetryCommand="{Binding RetryComingSoonCommand}" />

            <!-- Rạp gần bạn -->
            <StackPanel Margin="40,20,40,48">
                <TextBlock Text="Rạp gần bạn" Style="{StaticResource TextH2}" />
                <TextBlock Text="{Binding LocationText}" Style="{StaticResource TextCaption}" Margin="0,4,0,14" />

                <!-- Lọc theo hãng -->
                <ItemsControl ItemsSource="{Binding BrandFilters}" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="HomeBrandFilter" Content="{Binding Name}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ctl:StatefulContent IsLoading="{Binding Nearby.IsLoading}" IsEmpty="{Binding Nearby.IsEmpty}" IsError="{Binding Nearby.IsError}"
                                     ErrorText="{Binding Nearby.Error}" RetryCommand="{Binding RetryNearbyCommand}"
                                     EmptyText="Không có rạp nào trong khu vực này" MinHeight="180">
                    <ctl:StatefulContent.Skeleton>
                        <WrapPanel>
                            <ctl:SkeletonBox Width="300" Height="170" Margin="0,0,16,16" />
                            <ctl:SkeletonBox Width="300" Height="170" Margin="0,0,16,16" />
                            <ctl:SkeletonBox Width="300" Height="170" Margin="0,0,16,16" />
                        </WrapPanel>
                    </ctl:StatefulContent.Skeleton>
                    <ItemsControl ItemsSource="{Binding Nearby.Items}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ctl:CinemaCard OpenCommand="{Binding DataContext.OpenCinemaCommand, ElementName=Root}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ctl:StatefulContent>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
