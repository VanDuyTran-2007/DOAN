<Window x:Class="CineBook.Views.AccountPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="420"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="{StaticResource NavyDarkest}"
        Foreground="{StaticResource TextPrimary}">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" Style="{StaticResource TextH3}" Margin="0,0,0,10" />
        <StackPanel x:Name="PasswordInputs">
            <TextBlock x:Name="CurrentLabel" Text="Mật khẩu hiện tại" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="Current" MaxLength="256" />
            <StackPanel x:Name="ChangeInputs">
                <TextBlock Text="Mật khẩu mới" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="NewPassword" MaxLength="256" />
                <TextBlock Text="Xác nhận mật khẩu mới" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="Confirmation" MaxLength="256" />
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="Error" Style="{StaticResource FieldError}" TextWrapping="Wrap" />
        <StackPanel x:Name="Verified" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock Text="Mật khẩu bạn vừa xác thực" Style="{StaticResource FieldLabel}" />
            <TextBlock x:Name="VerifiedText" TextWrapping="Wrap" Style="{StaticResource TextBody}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CloseButton" Content="Đóng" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
            <Button x:Name="Submit" Content="Xác thực" IsDefault="True" Click="OnSubmit"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</Window>
