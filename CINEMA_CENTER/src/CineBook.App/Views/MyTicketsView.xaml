<UserControl x:Class="CineBook.Views.MyTicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CineBook.Controls">
    <!-- DataContext = MyTicketsViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28,40,48" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Vé của tôi" Style="{StaticResource TextH1}" Margin="0,0,0,16" />

            <!-- Chưa đăng nhập -->
            <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource InvBoolToVis}}" Margin="0,40">
                <TextBlock Text="Bạn cần đăng nhập để xem vé đã đặt." Style="{StaticResource TextSecondaryBody}" />
                <Button Content="Đăng nhập" Style="{StaticResource PrimaryButton}" Command="{Binding SignInCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
            </StackPanel>

            <ctl:StatefulContent Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}" IsLoading="{Binding Tickets.IsLoading}"
                                 IsEmpty="{Binding Tickets.IsEmpty}" IsError="{Binding Tickets.IsError}" ErrorText="{Binding Tickets.Error}"
                                 RetryCommand="{Binding RetryCommand}" EmptyText="Bạn chưa có vé nào" MinHeight="200">
                <ctl:StatefulContent.Skeleton>
                    <StackPanel><ctl:SkeletonBox Height="110" Margin="0,0,0,12" /><ctl:SkeletonBox Height="110" Margin="0,0,0,12" /></StackPanel>
                </ctl:StatefulContent.Skeleton>
                <ItemsControl ItemsSource="{Binding Tickets.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding MovieTitle}" Style="{StaticResource TextH3}" />
                                        <TextBlock Style="{StaticResource TextSecondaryBody}" Margin="0,4,0,0">
                                            <Run Text="{Binding CinemaName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding AuditoriumName, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource TextSecondaryBody}">
                                            <Run Text="{Binding StartTime, Mode=OneWay, StringFormat='HH:mm dd/MM/yyyy'}" /><Run Text=" · Ghế " /><Run Text="{Binding SeatsText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Code}" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource AccentGold}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding TotalAmount, Converter={StaticResource Money}}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ctl:StatefulContent>
        </StackPanel>
    </ScrollViewer>
</UserControl>
