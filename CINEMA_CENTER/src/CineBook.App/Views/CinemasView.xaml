<UserControl x:Class="CineBook.Views.CinemasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CineBook.Controls">
    <!-- DataContext = CinemasViewModel. 3 cột: bộ lọc | danh sách cơ sở | phim + lịch chiếu của rạp đang chọn -->
    <UserControl.Resources>
        <!-- Item rạp có trạng thái chọn -->
        <DataTemplate x:Key="CinemaRow">
            <Button Command="{Binding DataContext.SelectCinemaCommand, RelativeSource={RelativeSource AncestorType=ctl:StatefulContent}}"
                    CommandParameter="{Binding}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,8">
                <Border Style="{StaticResource CardBorder}" Padding="14,12" Background="{StaticResource NavySurface}">
                    <StackPanel>
                        <Grid>
                            <ctl:BrandLogo BrandId="{Binding Brand.Id}" BrandName="{Binding Brand.Name}" />
                        </Grid>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Margin="0,8,0,2" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Address}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,0">
                            <Run Text="{Binding District, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding City, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,24,32,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Cột 1: bộ lọc ===== -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Rạp chiếu" Style="{StaticResource TextH2}" Margin="0,0,0,16" />
            <TextBlock Text="Hệ thống rạp" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding BrandFilters}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="CinemasBrand" Margin="0,0,8,8" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Thành phố" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCityOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Quận / Huyện" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Districts}" SelectedItem="{Binding SelectedDistrictOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- ===== Cột 2: danh sách cơ sở ===== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,24">
            <ctl:StatefulContent IsLoading="{Binding CinemaList.IsLoading}" IsEmpty="{Binding CinemaList.IsEmpty}" IsError="{Binding CinemaList.IsError}"
                                 ErrorText="{Binding CinemaList.Error}" RetryCommand="{Binding RetryCinemasCommand}" EmptyText="Không có rạp phù hợp với bộ lọc">
                <ctl:StatefulContent.Skeleton>
                    <StackPanel>
                        <ctl:SkeletonBox Height="100" Margin="0,0,0,8" /><ctl:SkeletonBox Height="100" Margin="0,0,0,8" />
                        <ctl:SkeletonBox Height="100" Margin="0,0,0,8" /><ctl:SkeletonBox Height="100" Margin="0,0,0,8" />
                    </StackPanel>
                </ctl:StatefulContent.Skeleton>
                <ItemsControl ItemsSource="{Binding CinemaList.Items}" ItemTemplate="{StaticResource CinemaRow}" />
            </ctl:StatefulContent>
        </ScrollViewer>

        <!-- ===== Cột 3: phim + lịch chiếu ===== -->
        <Grid Grid.Column="4">
            <TextBlock Text="Chọn một rạp bên trái để xem phim đang chiếu và lịch chiếu" Style="{StaticResource TextSecondaryBody}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSelectedCinema, Converter={StaticResource InvBoolToVis}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,24" Visibility="{Binding HasSelectedCinema, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedCinema.Name}" Style="{StaticResource TextH2}" />
                    <TextBlock Text="{Binding SelectedCinema.Address}" Style="{StaticResource TextCaption}" Margin="0,2,0,12" />
                    <ctl:DateStrip ItemsSource="{Binding Dates}" Margin="0,0,0,16" />

                    <ctl:StatefulContent IsLoading="{Binding Detail.IsLoading}" IsEmpty="{Binding Detail.IsEmpty}" IsError="{Binding Detail.IsError}"
                                         ErrorText="{Binding Detail.Error}" RetryCommand="{Binding RetryDetailCommand}" EmptyText="Rạp chưa có suất chiếu trong ngày này" MinHeight="200">
                        <ctl:StatefulContent.Skeleton>
                            <StackPanel><ctl:SkeletonBox Height="130" Margin="0,0,0,12" /><ctl:SkeletonBox Height="130" Margin="0,0,0,12" /></StackPanel>
                        </ctl:StatefulContent.Skeleton>
                        <ItemsControl ItemsSource="{Binding Detail.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <ctl:PosterView DataContext="{Binding Movie}" Width="80" Height="120" VerticalAlignment="Top" />
                                            <StackPanel Margin="16,0,0,0" MaxWidth="560">
                                                <TextBlock Text="{Binding Movie.Title}" Style="{StaticResource TextH3}" />
                                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,6">
                                                    <Run Text="{Binding Movie.AgeRating, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Movie.GenresText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Movie.DurationText, Mode=OneWay}" />
                                                </TextBlock>
                                                <ctl:ShowtimeGroupsView Groups="{Binding Groups}"
                                                                        BookCommand="{Binding DataContext.BookCommand, RelativeSource={RelativeSource AncestorType=ctl:StatefulContent}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ctl:StatefulContent>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
