<UserControl x:Class="CineBook.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CineBook.Controls">
    <!-- DataContext = CategoriesViewModel -->
    <ctl:CinematicPreviewHost BookMovieCommand="{Binding BookMovieCommand}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28,40,48">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Style="{StaticResource TextH1}" />
                <TextBlock Style="{StaticResource TextCaption}" VerticalAlignment="Bottom" Margin="14,0,0,8">
                    <Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" phim" />
                </TextBlock>
            </StackPanel>

            <!-- Bộ lọc -->
            <WrapPanel Margin="0,16,0,8">
                <StackPanel Margin="0,0,16,8" Width="190">
                    <TextBlock Text="Thể loại" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,16,8" Width="160">
                    <TextBlock Text="Trạng thái" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,16,8" Width="160">
                    <TextBlock Text="Định dạng" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,16,8" Width="180">
                    <TextBlock Text="Sắp xếp" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                    <ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </WrapPanel>

            <ctl:StatefulContent IsLoading="{Binding IsLoading}" IsEmpty="{Binding IsEmpty}" IsError="{Binding IsError}" ErrorText="{Binding Error}"
                                 RetryCommand="{Binding RetryCommand}" EmptyText="Không có phim phù hợp với bộ lọc" MinHeight="300">
                <ctl:StatefulContent.Skeleton>
                    <WrapPanel>
                        <StackPanel Width="170" Margin="8,12"><ctl:SkeletonBox Height="255" /><ctl:SkeletonBox Height="14" Margin="0,10,40,0" /></StackPanel>
                        <StackPanel Width="170" Margin="8,12"><ctl:SkeletonBox Height="255" /><ctl:SkeletonBox Height="14" Margin="0,10,40,0" /></StackPanel>
                        <StackPanel Width="170" Margin="8,12"><ctl:SkeletonBox Height="255" /><ctl:SkeletonBox Height="14" Margin="0,10,40,0" /></StackPanel>
                        <StackPanel Width="170" Margin="8,12"><ctl:SkeletonBox Height="255" /><ctl:SkeletonBox Height="14" Margin="0,10,40,0" /></StackPanel>
                    </WrapPanel>
                </ctl:StatefulContent.Skeleton>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ctl:MoviePosterCard OpenCommand="{Binding DataContext.OpenMovieCommand, RelativeSource={RelativeSource AncestorType=ctl:StatefulContent}}"
                                                     RemindCommand="{Binding DataContext.RemindCommand, RelativeSource={RelativeSource AncestorType=ctl:StatefulContent}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Tải thêm" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0" Padding="32,10"
                            Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"
                            IsEnabled="{Binding IsLoadingMore, Converter={StaticResource InvBool}}" />
                </StackPanel>
            </ctl:StatefulContent>
        </StackPanel>
    </ScrollViewer>
    </ctl:CinematicPreviewHost>
</UserControl>
