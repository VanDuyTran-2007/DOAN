<UserControl x:Class="CineBook.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextPrimary}">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Padding" Value="0,0,0,5" />
        </Style>
        <Style x:Key="AccountPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NavySurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource NavyBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1060" Margin="40,32,40,48">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Tải lại" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButton}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}" />
                <TextBlock Text="Tài khoản cá nhân" Style="{StaticResource TextH2}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Margin="0,8,0,0" />

            <TabControl Margin="0,16,0,0" Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}"
                        SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                <TabItem Header="Thông tin chung" Visibility="{Binding MustSetPassword, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel Margin="0,18,0,0">
                        <Border Style="{StaticResource AccountPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="96" Height="96" Margin="0,0,22,0" VerticalAlignment="Top">
                                    <Ellipse Fill="{StaticResource Burgundy}" />
                                    <TextBlock Text="{Binding Profile.FullName, Converter={StaticResource FirstLetter}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36" FontWeight="Bold"
                                               Visibility="{Binding State.AccountAvatar, Converter={StaticResource NullToVisible}}" />
                                    <Ellipse Visibility="{Binding State.AccountAvatar, Converter={StaticResource NullToCollapsed}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding State.AccountAvatar}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Profile.FullName}" Style="{StaticResource TextH2}" />
                                    <TextBlock Text="Chào bạn, chúc bạn có một buổi xem phim thật vui!" Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,4,0,12" />
                                    <Button Content="Đổi ảnh đại diện" Style="{StaticResource SecondaryButton}" Click="OnUploadAvatar"
                                            HorizontalAlignment="Left" IsEnabled="{Binding CanChangeAvatar}" />
                                    <TextBlock Text="{Binding Profile.AvatarStatus}" Style="{StaticResource TextCaption}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <UniformGrid Columns="2" Margin="0,14,0,14">
                            <Border Style="{StaticResource AccountPanel}" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="Cấp độ tài khoản" Style="{StaticResource TextCaption}" />
                                    <TextBlock Text="{Binding Profile.Rank}" Style="{StaticResource TextH3}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource AccountPanel}" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Tổng chi tiêu" Style="{StaticResource TextCaption}" />
                                    <TextBlock Text="{Binding Profile.Spending}" Style="{StaticResource TextH3}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource AccountPanel}">
                            <StackPanel>
                                <TextBlock Text="Liên hệ tài khoản" Style="{StaticResource TextH3}" />
                                <UniformGrid Columns="3" Margin="0,14,0,0">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Tên đăng ký" Style="{StaticResource TextCaption}" />
                                        <TextBlock Text="{Binding Profile.FullName}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Email" Style="{StaticResource TextCaption}" />
                                        <TextBlock Text="{Binding Profile.Email}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Số điện thoại" Style="{StaticResource TextCaption}" />
                                        <TextBlock Text="{Binding Profile.Phone}" Margin="0,5,0,0" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Chi tiết tài khoản">
                    <Border Style="{StaticResource AccountPanel}" Margin="0,18,0,0">
                        <StackPanel>
                            <StackPanel MaxWidth="420" HorizontalAlignment="Left"
                                        Visibility="{Binding MustSetPassword, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Đặt mật khẩu cho CineBook" Style="{StaticResource TextH3}" />
                                <TextBlock Text="Bạn cần đặt mật khẩu cho tài khoản mới để tiếp tục." TextWrapping="Wrap"
                                           Style="{StaticResource TextBody}" Margin="0,6,0,4" />
                                <Label Content="Mật khẩu mới" Target="{Binding ElementName=InitialPassword}" Margin="0,10,0,0" />
                                <PasswordBox x:Name="InitialPassword" MaxLength="256" />
                                <Label Content="Xác nhận mật khẩu" Target="{Binding ElementName=InitialConfirmation}" Margin="0,10,0,0" />
                                <PasswordBox x:Name="InitialConfirmation" MaxLength="256" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Lưu mật khẩu" Style="{StaticResource PrimaryButton}" Click="OnSetInitialPassword" />
                                    <Button Content="Đăng xuất" Style="{StaticResource SecondaryButton}" Command="{Binding SignOutCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Visibility="{Binding MustSetPassword, Converter={StaticResource InvBoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Label Content="Tên đăng ký" Target="{Binding ElementName=FullNameInput}" />
                                    <TextBox x:Name="FullNameInput" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                                    <Label Content="Email chính" Target="{Binding ElementName=EmailInput}" Margin="0,10,0,0" />
                                    <TextBox x:Name="EmailInput" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" />
                                    <Label Content="Email phụ 1" Target="{Binding ElementName=Secondary1}" Margin="0,10,0,0" />
                                    <TextBox x:Name="Secondary1" Text="{Binding SecondaryEmail1, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" />
                                    <Label Content="Email phụ 2" Target="{Binding ElementName=Secondary2}" Margin="0,10,0,0" />
                                    <TextBox x:Name="Secondary2" Text="{Binding SecondaryEmail2, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Số điện thoại" Target="{Binding ElementName=PhoneInput}" />
                                    <TextBox x:Name="PhoneInput" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" />
                                    <Label Content="Thành phố / tỉnh" Target="{Binding ElementName=CityInput}" Margin="0,10,0,0" />
                                    <ComboBox x:Name="CityInput" ItemsSource="{Binding Cities}" IsEditable="True" IsTextSearchEnabled="False"
                                              Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" />
                                    <Label Content="Quận / huyện" Target="{Binding ElementName=DistrictInput}" Margin="0,10,0,0" />
                                    <TextBox x:Name="DistrictInput" Text="{Binding District, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
                                    <Label Content="Ngày sinh" Margin="0,10,0,0" />
                                    <TextBox Text="{Binding Profile.DateOfBirth, Mode=OneWay}" IsReadOnly="True" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Lưu thay đổi" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Margin="0,20,0,0" />
                            <Border Background="{StaticResource NavyBorder}" Height="1" Margin="0,22,0,16" />
                            <TextBlock Text="Mật khẩu" Style="{StaticResource TextH3}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Background="{StaticResource NavyDark}" CornerRadius="6" Margin="0,0,12,0" Padding="12,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="••••••••" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource GhostButton}" Click="OnVerifyPassword" IsEnabled="{Binding CanVerify}"
                                                AutomationProperties.Name="Xác thực để xem mật khẩu" Padding="10,6">
                                            <Path Data="{StaticResource IconEye}" Fill="{StaticResource TextSecondary}" Stretch="Uniform" Width="18" Height="18" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Button Content="Đổi mật khẩu" Style="{StaticResource SecondaryButton}" Click="OnChangePassword" />
                            </StackPanel>
                            <TextBlock Text="Đã khóa tính năng xem mật khẩu. Hãy đổi mật khẩu để mở lại."
                                       Style="{StaticResource FieldError}" Margin="0,8,0,0"
                                       Visibility="{Binding CanVerify, Converter={StaticResource InvBoolToVis}}" />
                            <Border Background="{StaticResource NavyBorder}" Height="1" Margin="0,22,0,16" />
                            <TextBlock Text="Liên kết đăng nhập" Style="{StaticResource TextH3}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{Binding GoogleLinkLabel}" Command="{Binding LinkProviderCommand}" CommandParameter="Google"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="{Binding FacebookLinkLabel}" Command="{Binding LinkProviderCommand}" CommandParameter="Facebook"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                            <TextBlock Text="Hoàn tất xác thực trong trình duyệt." Style="{StaticResource TextCaption}" Margin="0,8,0,0"
                                       Visibility="{Binding LinkProviderCommand.IsRunning, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="Voucher" Visibility="{Binding MustSetPassword, Converter={StaticResource InvBoolToVis}}">
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="Đang tải voucher…" Style="{StaticResource TextBody}"
                                   Visibility="{Binding Vouchers.IsLoading, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Hiện chưa có voucher đang phát hành." Style="{StaticResource TextBody}"
                                   Visibility="{Binding Vouchers.IsEmpty, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Vouchers.Error}" Style="{StaticResource FieldError}"
                                   Visibility="{Binding Vouchers.IsError, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Vouchers.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AccountPanel}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource TextH3}" />
                                            <TextBlock Text="{Binding Code}" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding ExpiryText}" Style="{StaticResource TextCaption}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
