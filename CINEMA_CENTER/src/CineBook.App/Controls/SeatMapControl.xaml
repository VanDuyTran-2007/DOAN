<UserControl x:Class="CineBook.Controls.SeatMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!--
        SƠ ĐỒ GHẾ – dựng hoàn toàn từ dữ liệu (không hard-code ghế trong XAML):
          Rows (ItemsControl) → mỗi hàng = nhãn + Canvas chứa các ghế + nhãn.
          Mỗi ghế đặt bằng Canvas.Left (= (cột - 1) × ô) nên:
            • lối đi = cột bị bỏ trống (không có ghế ở cột đó)
            • ghế đôi = ghế có ColumnSpan 2 → rộng gấp đôi
        Style ghế theo LOẠI (Thường / VIP / Đôi) và TRẠNG THÁI (Trống / Đang chọn / Đã đặt / Người khác giữ / Không khả dụng).
        Zoom: nút +/− hoặc Ctrl + lăn chuột; ScrollViewer cho phép kéo khi phòng lớn.
    -->
    <UserControl.Resources>
        <!-- Ghế "người khác đang giữ": nền sọc chéo -->
        <DrawingBrush x:Key="HoldingHatch" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Viewbox="0,0,8,8" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource NavySurface}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8" /></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen><Pen Brush="{StaticResource TextMuted}" Thickness="1.4" /></GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry><LineGeometry StartPoint="-1,9" EndPoint="9,-1" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="SeatButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Height="32" CornerRadius="7,7,3,3" BorderThickness="1.5" BorderBrush="{StaticResource TextMuted}"
                                Background="Transparent" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="150">
                            <Grid>
                                <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- Dấu × cho ghế đã đặt -->
                                <Path x:Name="Cross" Data="M2,2 L10,10 M10,2 L2,10" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Width="12" Height="12"
                                      Stretch="Uniform" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Theo LOẠI ghế -->
                            <DataTrigger Binding="{Binding Type}" Value="Vip">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGold}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Couple">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BurgundyHover}" />
                                <Setter TargetName="Bd" Property="Background" Value="#33800020" />
                            </DataTrigger>
                            <!-- Hover (chỉ ghế bấm được) -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsInteractive}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavyBorder}" />
                            </MultiDataTrigger>
                            <!-- Theo TRẠNG THÁI -->
                            <DataTrigger Binding="{Binding Status}" Value="Selected">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Burgundy}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BurgundyHover}" />
                                <Setter TargetName="Num" Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Booked">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavyBorder}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NavyBorder}" />
                                <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Holding">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoldingHatch}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource NavyBorder}" />
                                <Setter TargetName="Num" Property="Visibility" Value="Collapsed" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Unavailable">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.2" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Chú thích (legend) -->
        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Margin="10,4"><Border Width="22" Height="18" CornerRadius="5,5,2,2" BorderThickness="1.5" BorderBrush="{StaticResource TextMuted}" /><TextBlock Text="Trống" Style="{StaticResource TextCaption}" Margin="6,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,4"><Border Width="22" Height="18" CornerRadius="5,5,2,2" BorderThickness="1.5" BorderBrush="{StaticResource AccentGold}" /><TextBlock Text="VIP" Style="{StaticResource TextCaption}" Margin="6,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,4"><Border Width="30" Height="18" CornerRadius="5,5,2,2" BorderThickness="1.5" BorderBrush="{StaticResource BurgundyHover}" Background="#33800020" /><TextBlock Text="Ghế đôi" Style="{StaticResource TextCaption}" Margin="6,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,4"><Border Width="22" Height="18" CornerRadius="5,5,2,2" BorderThickness="1.5" BorderBrush="{StaticResource BurgundyHover}" Background="{StaticResource Burgundy}" /><TextBlock Text="Đang chọn" Style="{StaticResource TextCaption}" Margin="6,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,4"><Border Width="22" Height="18" CornerRadius="5,5,2,2" Background="{StaticResource NavyBorder}"><Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="{StaticResource TextMuted}" StrokeThickness="1.2" Stretch="Uniform" Margin="5,3" /></Border><TextBlock Text="Đã đặt" Style="{StaticResource TextCaption}" Margin="6,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,4"><Border Width="22" Height="18" CornerRadius="5,5,2,2" BorderThickness="1.5" BorderBrush="{StaticResource NavyBorder}" Background="{StaticResource HoldingHatch}" /><TextBlock Text="Người khác đang giữ" Style="{StaticResource TextCaption}" Margin="6,0,0,0" /></StackPanel>
        </WrapPanel>

        <!-- Thanh zoom -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,4">
            <TextBlock Text="Ctrl + lăn chuột để phóng to/thu nhỏ" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Style="{StaticResource IconButton}" Click="OnZoomOut" Width="30" Height="30"><Path Data="{StaticResource IconMinus}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" /></Button>
            <TextBlock Text="{Binding Zoom, ElementName=Root, StringFormat={}{0:P0}}" VerticalAlignment="Center" Width="46" TextAlignment="Center" />
            <Button Style="{StaticResource IconButton}" Click="OnZoomIn" Width="30" Height="30"><Path Data="{StaticResource IconPlus}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" /></Button>
        </StackPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnWheel">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16">
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Zoom, ElementName=Root}" ScaleY="{Binding Zoom, ElementName=Root}" />
                </Grid.LayoutTransform>
                <StackPanel>
                    <!-- ===== Màn hình cong phát sáng ===== -->
                    <Grid Width="560" Height="70" Margin="0,0,0,26" HorizontalAlignment="Center">
                        <!-- Chùm sáng hắt xuống -->
                        <Path Data="M 20,34 Q 280,2 540,34 L 600,80 L -40,80 Z" Stretch="Fill" Opacity="0.9">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33F5F5F7" Offset="0" />
                                    <GradientStop Color="#00F5F5F7" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <!-- Đường cong màn hình -->
                        <Path Data="M 20,34 Q 280,2 540,34" Stretch="Fill" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Top" Height="34">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00F5F5F7" Offset="0" />
                                    <GradientStop Color="{StaticResource TextPrimaryColor}" Offset="0.5" />
                                    <GradientStop Color="#00F5F5F7" Offset="1" />
                                </LinearGradientBrush>
                            </Path.Stroke>
                            <Path.Effect><DropShadowEffect Color="White" BlurRadius="22" ShadowDepth="0" Opacity="0.8" /></Path.Effect>
                        </Path>
                        <TextBlock Text="MÀN HÌNH" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                    </Grid>

                    <!-- ===== Các hàng ghế ===== -->
                    <ItemsControl ItemsSource="{Binding Rows, ElementName=Root}" HorizontalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Label}" Width="26" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                    <ItemsControl ItemsSource="{Binding Seats}" Width="{Binding Width}" Height="32">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource SeatButton}" Width="{Binding Width}"
                                                        Command="{Binding SeatCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                        IsHitTestVisible="True" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Label}" Width="26" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
