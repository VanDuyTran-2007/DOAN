<UserControl x:Class="CineBook.Controls.BookingStepDone"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CineBook.Controls">
    <!-- ⑤ Hoàn tất: vé điện tử + QR. DataContext = BookingViewModel -->
    <StackPanel HorizontalAlignment="Center" Margin="0,8,0,0">
        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
            <Ellipse Width="56" Height="56" Fill="{StaticResource Success}" />
            <Path Data="{StaticResource IconCheck}" Fill="White" Width="30" Height="30" Stretch="Uniform" Margin="0,-43,0,0" />
            <TextBlock Text="Đặt vé thành công!" Style="{StaticResource TextH2}" HorizontalAlignment="Center" Margin="0,22,0,0" />
            <TextBlock Text="Vui lòng đưa mã QR dưới đây tại quầy để nhận vé." Style="{StaticResource TextSecondaryBody}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Vé điện tử -->
        <Border CornerRadius="14" Width="640" Background="{StaticResource NavySurface}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions>

                <StackPanel Margin="26,24">
                    <TextBlock Text="CineBook · VÉ ĐIỆN TỬ" Style="{StaticResource TextCaption}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CompletedBooking.MovieTitle}" Style="{StaticResource TextH2}" Margin="0,6,0,10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CompletedBooking.CinemaName}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource TextSecondaryBody}" Margin="0,2,0,0">
                        <Run Text="{Binding CompletedBooking.AuditoriumName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CompletedBooking.StartTime, Mode=OneWay, StringFormat='HH:mm dd/MM/yyyy'}" />
                    </TextBlock>
                    <TextBlock Text="Ghế" Style="{StaticResource TextCaption}" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding CompletedBooking.SeatsText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentGold}" TextWrapping="Wrap" />
                    <TextBlock Text="Tổng thanh toán" Style="{StaticResource TextCaption}" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding CompletedBooking.TotalAmount, Converter={StaticResource Money}}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>

                <!-- Đường cắt vé -->
                <Border Grid.Column="1" Width="1" Margin="0,16" Background="{StaticResource NavyBorder}" />

                <StackPanel Grid.Column="2" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="White" Padding="8" CornerRadius="8" HorizontalAlignment="Center">
                        <ctl:QrPlaceholder Code="{Binding CompletedBooking.Code}" Width="150" Height="150" />
                    </Border>
                    <TextBlock Text="Mã đặt vé" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding CompletedBooking.Code}" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,32">
            <Button Content="Về trang chủ" Style="{StaticResource CtaButton}" Command="{Binding GoHomeCommand}" Margin="0,0,10,0" />
            <Button Content="Vé của tôi" Style="{StaticResource SecondaryButton}" Padding="22,13" Command="{Binding GoMyTicketsCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
