<UserControl x:Class="CineBook.Controls.CinematicTrailerPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ContentControl x:Name="InlineSurface" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Border x:Name="PlayerSurface" CornerRadius="10" Background="{StaticResource NavyDarkest}"
                BorderThickness="1" BorderBrush="{StaticResource GlassBorder}" ClipToBounds="True">
            <Grid>
                <Grid x:Name="Cover" ClipToBounds="True" IsHitTestVisible="False">
                    <Border x:Name="CoverGlow" />
                    <Viewbox Margin="20" StretchDirection="DownOnly">
                        <StackPanel Width="330">
                            <TextBlock Text="CINEBOOK" Foreground="{StaticResource AccentGold}" FontSize="11"
                                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,7" />
                            <TextBlock x:Name="CoverTitle" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource TextPrimary}" FontSize="24" FontWeight="Bold" />
                        </StackPanel>
                    </Viewbox>
                    <Image x:Name="Backdrop" Stretch="UniformToFill" ImageFailed="OnImageFailed" />
                </Grid>
                <Grid x:Name="VideoSurface" IsHitTestVisible="False" />
                <Border x:Name="ControlsPanel" VerticalAlignment="Bottom" Padding="12,7">
                    <Border.Background>
                        <SolidColorBrush Color="{StaticResource NavyDarkestColor}" Opacity=".90" />
                    </Border.Background>
                    <StackPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource TextCaption}" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,0,0,4" />
                        <Slider x:Name="Seek" Minimum="0" Maximum="1" IsEnabled="False" IsMoveToPointEnabled="True"
                                AutomationProperties.Name="Tiến trình trailer" ValueChanged="OnSeek" />
                        <DockPanel LastChildFill="False" Margin="0,4,0,0">
                            <Button x:Name="PlaybackButton" Content="Phát" Style="{StaticResource SecondaryButton}" Padding="10,3"
                                    Click="OnPlayback" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="TimeText" Text="0:00 / --:--" Style="{StaticResource TextCaption}"
                                       Margin="8,0" VerticalAlignment="Center" />
                            <Button x:Name="FullscreenButton" DockPanel.Dock="Right" Content="⛶" Style="{StaticResource SecondaryButton}"
                                    Padding="8,3" Click="OnFullscreen" AutomationProperties.Name="Toàn màn hình" />
                            <Slider x:Name="Volume" DockPanel.Dock="Right" Width="58" Minimum="0" Maximum="1" Value=".7"
                                    Margin="4,0,8,0" VerticalAlignment="Center" ValueChanged="OnVolume"
                                    AutomationProperties.Name="Âm lượng trailer" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </ContentControl>
</UserControl>
