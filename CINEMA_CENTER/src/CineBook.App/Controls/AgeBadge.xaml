<UserControl x:Class="CineBook.Controls.AgeBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" HorizontalAlignment="Left" VerticalAlignment="Top">
    <!-- Age rating badge (P, K, T13, T16, T18): red rectangle, big white code, thin dark strip with repeated small code.
         The strip uses the same corner radius as the outer border, so nothing sticks out of the rounded corners. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="AgeRed" Color="#D92D20" />
        <SolidColorBrush x:Key="AgeStrip" Color="#99000000" />
    </UserControl.Resources>

    <Border CornerRadius="4" Background="{StaticResource AgeRed}" MinWidth="44" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Code, ElementName=Root}" FontSize="15" FontWeight="ExtraBold"
                       Foreground="White" HorizontalAlignment="Center" Margin="6,3,6,2" />

            <Border Grid.Row="1" CornerRadius="0,0,4,4" Background="{StaticResource AgeStrip}" Height="9" ClipToBounds="True">
                <TextBlock Text="{Binding Code, ElementName=Root, Converter={StaticResource RepeatText}}"
                           FontSize="6.5" FontWeight="Bold" Foreground="White" Opacity="0.9"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"
                           TextWrapping="NoWrap" TextOptions.TextFormattingMode="Display" />
            </Border>
        </Grid>
    </Border>
</UserControl>
