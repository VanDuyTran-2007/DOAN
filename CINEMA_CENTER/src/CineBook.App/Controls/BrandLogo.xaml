<UserControl x:Class="CineBook.Controls.BrandLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" HorizontalAlignment="Left">
    <!-- Cinema brand logo with no background. The Cinestar PNG has its black lettering recolored to near-white so it reads on the navy UI.
         Chosen by BrandId; unknown brands fall back to the brand name as text.
         Lotte and BHD are vector paths; CGV and Cinestar are PNG resources in Assets/Brands. -->
    <UserControl.Resources>
        <Style x:Key="ShowFor" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Height" Value="22" />
        </Style>

        <Style x:Key="LogoCgv" TargetType="Image" BasedOn="{StaticResource ShowFor}">
            <Style.Triggers><DataTrigger Binding="{Binding BrandId, ElementName=Root}" Value="cgv"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="LogoCinestar" TargetType="Image" BasedOn="{StaticResource ShowFor}">
            <Style.Triggers><DataTrigger Binding="{Binding BrandId, ElementName=Root}" Value="cinestar"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="LogoLotte" TargetType="Path" BasedOn="{StaticResource ShowFor}">
            <Style.Triggers><DataTrigger Binding="{Binding BrandId, ElementName=Root}" Value="lotte"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="LogoBhd" TargetType="Path" BasedOn="{StaticResource ShowFor}">
            <Style.Triggers><DataTrigger Binding="{Binding BrandId, ElementName=Root}" Value="bhd"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>

        <!-- Fallback text: hidden when a known logo is shown -->
        <Style x:Key="LogoFallback" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BrandId, ElementName=Root}" Value="cgv"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding BrandId, ElementName=Root}" Value="cinestar"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding BrandId, ElementName=Root}" Value="lotte"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <DataTrigger Binding="{Binding BrandId, ElementName=Root}" Value="bhd"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="Transparent" ToolTip="{Binding BrandName, ElementName=Root}">
        <Grid>
            <Image Style="{StaticResource LogoCgv}" Source="/Assets/Brands/cgv.png" Stretch="Uniform" />
            <Image Style="{StaticResource LogoCinestar}" Source="/Assets/Brands/cinestar.png" Stretch="Uniform" />

