<UserControl x:Class="CineBook.Controls.BookingSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CineBook.Controls">
    <!-- Panel tóm tắt bên phải. DataContext = BookingViewModel -->
    <Border Style="{StaticResource CardBorder}" Padding="18">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <ctl:PosterView DataContext="{Binding Movie}" Width="72" Height="108" VerticalAlignment="Top" />
                <StackPanel Margin="14,0,0,0" MaxWidth="200">
                    <TextBlock Text="{Binding Movie.Title}" Style="{StaticResource TextH3}" TextWrapping="Wrap" />
                    <Border Padding="8,2" CornerRadius="999" HorizontalAlignment="Left" Margin="0,6,0,0" Background="{Binding Movie.AgeRating, Converter={StaticResource AgeBrush}}">
                        <TextBlock Text="{Binding Movie.AgeRating}" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding Showtime.FormatText}" Style="{StaticResource TextCaption}" Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{StaticResource NavyBorder}" Margin="0,14" />

            <TextBlock Text="{Binding Cinema.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource TextCaption}" Margin="0,4,0,0">
                <Run Text="{Binding Showtime.AuditoriumName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Showtime.StartTime, Mode=OneWay, StringFormat='HH:mm dd/MM/yyyy'}" />
            </TextBlock>

            <Border Height="1" Background="{StaticResource NavyBorder}" Margin="0,14" />

            <TextBlock Text="Ghế đã chọn" Style="{StaticResource TextCaption}" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
                        <Setter Property="Text" Value="{Binding SelectedSeatsText}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedSeats}" Value="False">
                                <Setter Property="Text" Value="Chưa chọn ghế" />
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Combo đã chọn -->
            <StackPanel Visibility="{Binding HasSelectedCombos, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                <TextBlock Text="Bắp nước" Style="{StaticResource TextCaption}" />
                <ItemsControl ItemsSource="{Binding ChosenCombos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,0">
                                <TextBlock><Run Text="{Binding Quantity, Mode=OneWay}" /><Run Text=" × " /><Run Text="{Binding Combo.Name, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="{Binding LineTotal, Converter={StaticResource Money}}" HorizontalAlignment="Right" Style="{StaticResource TextCaption}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Height="1" Background="{StaticResource NavyBorder}" Margin="0,14" />

            <StackPanel Margin="0,0,0,8" Visibility="{Binding HasMemberDiscount, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Tạm tính" Style="{StaticResource TextCaption}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Subtotal, Converter={StaticResource Money}}" Style="{StaticResource TextCaption}" />
                </DockPanel>
                <DockPanel LastChildFill="False" Margin="0,4,0,0">
                    <TextBlock Text="{Binding MemberDiscountLabel}" Style="{StaticResource TextCaption}" Foreground="{StaticResource Success}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextCaption}" Foreground="{StaticResource Success}">
                        <Run Text="−" /><Run Text="{Binding MemberDiscount, Mode=OneWay, Converter={StaticResource Money}}" />
                    </TextBlock>
                </DockPanel>
            </StackPanel>

            <Grid>
                <TextBlock Text="Cần thanh toán" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="{Binding GrandTotal, Converter={StaticResource Money}}" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentGold}" />
            </Grid>

            <!-- Đồng hồ giữ ghế -->
            <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource NavyDark}" BorderBrush="{StaticResource NavyBorder}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="Thời gian giữ ghế" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CountdownText}" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentGold}" Visibility="{Binding IsHolding, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="10:00 sau khi giữ ghế" HorizontalAlignment="Right" Style="{StaticResource TextCaption}" Foreground="{StaticResource TextMuted}"
                               Visibility="{Binding IsHolding, Converter={StaticResource InvBoolToVis}}" />
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
