<UserControl x:Class="CineBook.Controls.ShowtimeGroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CineBook.Controls">
    <!-- Các nhóm giờ chiếu theo định dạng: "2D Phụ đề" → [10:30] [13:00] ... ; bấm giờ → BookCommand(Showtime) -->
    <ItemsControl ItemsSource="{Binding Groups, RelativeSource={RelativeSource AncestorType=ctl:ShowtimeGroupsView}}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Margin="0,6,0,4">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Times}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding TimeText}" Style="{StaticResource SecondaryButton}" Padding="16,7" Margin="0,0,8,8"
                                        Command="{Binding BookCommand, RelativeSource={RelativeSource AncestorType=ctl:ShowtimeGroupsView}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
