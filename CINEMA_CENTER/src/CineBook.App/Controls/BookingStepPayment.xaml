<UserControl x:Class="CineBook.Controls.BookingStepPayment"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CineBook.Controls"
             x:Name="Root">
    <!-- ④ Thanh toán (chỉ là UI, backend xử lý thật sau). DataContext = BookingViewModel -->
    <UserControl.Resources>
        <!-- Thẻ chọn phương thức thanh toán -->
        <Style x:Key="PayCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="16,14" CornerRadius="8" BorderThickness="1.5" BorderBrush="{StaticResource NavyBorder}" Background="{StaticResource NavySurface}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource BrandGradient}">
                                    <TextBlock Text="{Binding Name, Converter={StaticResource FirstLetter}}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TextH3}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource TextCaption}" />
                                </StackPanel>
                                <Ellipse x:Name="Dot" Grid.Column="2" Width="20" Height="20" Stroke="{StaticResource TextMuted}" StrokeThickness="2" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Burgundy}" />
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Burgundy}" />
                                <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource BurgundyHover}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource NavyBorder}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel>
            <TextBlock Text="Thanh toán" Style="{StaticResource TextH2}" />
            <TextBlock Text="Chọn phương thức thanh toán" Style="{StaticResource TextCaption}" Margin="0,4,0,14" />
            <ItemsControl ItemsSource="{Binding PaymentOptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource PayCard}" GroupName="PaymentMethod" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding PaymentError}" Style="{StaticResource FieldError}" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource TextCaption}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Text="Bản demo: bấm Thanh toán sẽ giả lập thành công sau 2 giây, không có giao dịch thật." />
        </StackPanel>

        <!-- Đang xử lý thanh toán -->
        <Border Background="{StaticResource ScrimBrush}" CornerRadius="8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Đang xử lý thanh toán..." Style="{StaticResource TextH3}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
