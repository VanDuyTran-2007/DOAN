<UserControl x:Class="CineBook.Controls.HeroBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CineBook.Controls"
             x:Name="Root" Height="440">
    <!-- DataContext = HomeViewModel. -->
    <UserControl.Resources>
        <!-- Chấm điều hướng: chấm đang chọn dài ra thành pill burgundy -->
        <Style x:Key="DotButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Dot" Height="8" Width="8" CornerRadius="4" Margin="4" Background="{StaticResource TextMuted}" />
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="28" />
                                <Setter TargetName="Dot" Property="Background" Value="{StaticResource Burgundy}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Background" Value="{StaticResource TextSecondary}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
                <DataTemplate x:Key="HeroSlide">
                    <Grid Background="{Binding Converter={StaticResource BackdropBrush}}">
                        <!-- Gradient navy phủ từ trái (cho chữ dễ đọc) và từ dưới lên -->
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="{StaticResource NavyDarkestColor}" Offset="0" />
                                    <GradientStop Color="#E6070F1F" Offset="0.36" />
                                    <GradientStop Color="#26070F1F" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Height="140" VerticalAlignment="Bottom">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00070F1F" Offset="0" />
                                    <GradientStop Color="{StaticResource NavyDarkestColor}" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <StackPanel VerticalAlignment="Center" Margin="64,0,0,20" MaxWidth="560" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Padding="9,3" CornerRadius="999" Background="{StaticResource AccentGold}" Margin="0,0,8,0">
                                    <TextBlock Text="HOT" FontSize="12" FontWeight="ExtraBold" Foreground="{StaticResource NavyDarkest}" />
                                </Border>
                                <Border Padding="9,3" CornerRadius="999" Background="{Binding AgeRating, Converter={StaticResource AgeBrush}}">
                                    <TextBlock Text="{Binding AgeRating}" FontSize="12" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="44" FontWeight="ExtraBold" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource TextSecondaryBody}">
                                <Run Text="{Binding GenresText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding DurationText, Mode=OneWay}" /><Run Text="  ·  ★ " /><Run Text="{Binding RatingText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Description}" Margin="0,12,0,0" Style="{StaticResource TextBody}" MaxHeight="44" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button Content="Đặt vé ngay" Style="{StaticResource CtaButton}" Margin="0,0,12,0"
                                        Command="{Binding DataContext.BookMovieCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                <Button Content="▶  Xem trailer" Style="{StaticResource SecondaryButton}" Padding="22,13"
                                        Command="{Binding DataContext.WatchTrailerCommand, ElementName=Root}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ctl:SkeletonBox Visibility="{Binding CurrentHero, Converter={StaticResource NullToVisible}}" />
        <Grid x:Name="Stage" Background="Transparent" ClipToBounds="True"
              PreviewMouseLeftButtonDown="OnPointerDown" PreviewMouseMove="OnPointerMove"
              PreviewMouseLeftButtonUp="OnPointerUp" LostMouseCapture="OnLostCapture">
            <ContentControl Content="{Binding CurrentHero}" ContentTemplate="{StaticResource HeroSlide}"
                            Visibility="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToCollapsed}}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.RenderTransform><TranslateTransform x:Name="CurrentSlideOffset" /></ContentControl.RenderTransform>
            </ContentControl>
            <ContentControl x:Name="IncomingSlide" ContentTemplate="{StaticResource HeroSlide}" IsHitTestVisible="False"
                            Visibility="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToCollapsed}}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.RenderTransform><TranslateTransform x:Name="IncomingSlideOffset" /></ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- Chấm điều hướng -->
        <ItemsControl ItemsSource="{Binding HeroDots}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource DotButton}" Command="{Binding DataContext.SelectHeroCommand, ElementName=Root}" CommandParameter="{Binding Index}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
