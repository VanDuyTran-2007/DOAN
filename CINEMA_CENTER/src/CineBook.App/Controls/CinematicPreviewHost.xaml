<UserControl x:Class="CineBook.Controls.CinematicPreviewHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CineBook.Controls"
             x:Name="Host" Focusable="False" ClipToBounds="True">
    <UserControl.Content>
        <Grid>
            <ctl:CinematicAmbientLayer x:Name="Ambient" />
            <ContentPresenter Content="{Binding Gallery, ElementName=Host}" />
            <Canvas x:Name="OverlayLayer">
                <Border x:Name="PreviewPanel" Visibility="Collapsed" CornerRadius="12" BorderThickness="1"
                        BorderBrush="{StaticResource GlassBorder}" Background="{StaticResource NavyDark}"
                        RenderTransformOrigin=".5,.4" MouseEnter="OnPanelEnter" MouseLeave="OnPanelLeave"
                        IsKeyboardFocusWithinChanged="OnPanelFocusChanged">
                    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="7" Opacity=".65" /></Border.Effect>
                    <Border.RenderTransform><ScaleTransform x:Name="PreviewScale" /></Border.RenderTransform>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  KeyboardNavigation.TabNavigation="Cycle">
                        <Grid>
                            <ctl:CinematicAmbientLayer x:Name="PreviewGlow" />
                            <StackPanel Margin="11">
                                <ctl:CinematicTrailerPlayer x:Name="PreviewVideo" Focusable="False" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource TextH3}" TextWrapping="Wrap" Margin="2,9,2,3" />
                                <WrapPanel Margin="2,0,2,7">
                                    <Border Background="{Binding AgeRating, Converter={StaticResource AgeBrush}}" CornerRadius="8" Padding="6,2" Margin="0,0,7,3">
                                        <TextBlock Text="{Binding AgeRating}" FontSize="11" FontWeight="Bold" />
                                    </Border>
                                    <TextBlock Foreground="{StaticResource AccentGold}" Margin="0,0,7,3"
                                               Text="{Binding RatingText, StringFormat='★ {0}'}" Visibility="{Binding HasRating, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding GenresText}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                </WrapPanel>
                                <WrapPanel>
                                    <Button x:Name="PrimaryAction" Style="{StaticResource PrimaryButton}" Click="OnPrimaryAction"
                                            Padding="11,6" Margin="0,0,6,4" />
                                    <Button x:Name="DetailAction" Content="Xem chi tiết" Style="{StaticResource SecondaryButton}"
                                            Padding="11,6" Margin="0,0,0,4" Click="OnDetailAction" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Canvas>
        </Grid>
    </UserControl.Content>
</UserControl>
