<UserControl x:Class="CineBook.Controls.StatefulContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="StateRoot">
    <!-- Hiển thị 1 trong 4 trạng thái: Loading (skeleton) / Empty / Error (có nút Thử lại) / Nội dung -->
    <Grid>
        <ContentPresenter Content="{Binding Body, ElementName=StateRoot}"
                          Visibility="{Binding ShowBody, ElementName=StateRoot, Converter={StaticResource BoolToVis}}" />
        <ContentPresenter Content="{Binding Skeleton, ElementName=StateRoot}"
                          Visibility="{Binding IsLoading, ElementName=StateRoot, Converter={StaticResource BoolToVis}}" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32"
                    Visibility="{Binding IsEmpty, ElementName=StateRoot, Converter={StaticResource BoolToVis}}">
            <Path Data="{StaticResource IconTicket}" Fill="{StaticResource TextMuted}" Width="36" Height="36" Stretch="Uniform" Margin="0,0,0,10" />
            <TextBlock Text="{Binding EmptyText, ElementName=StateRoot}" Style="{StaticResource TextSecondaryBody}" TextAlignment="Center" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32"
                    Visibility="{Binding IsError, ElementName=StateRoot, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Không tải được dữ liệu" Style="{StaticResource TextH3}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ErrorText, ElementName=StateRoot}" Style="{StaticResource TextError}" HorizontalAlignment="Center" Margin="0,4,0,12" />
            <Button Content="Thử lại" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                    Command="{Binding RetryCommand, ElementName=StateRoot}" />
        </StackPanel>
    </Grid>
</UserControl>
