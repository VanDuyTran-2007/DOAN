<UserControl x:Class="CineBook.Controls.BookingStepCombos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- ③ Bắp nước. DataContext = BookingViewModel -->
    <StackPanel>
        <TextBlock Text="Bắp nước" Style="{StaticResource TextH2}" />
        <TextBlock Text="Chọn thêm combo (không bắt buộc)" Style="{StaticResource TextCaption}" Margin="0,4,0,14" />
        <ItemsControl ItemsSource="{Binding Combos}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Ảnh placeholder -->
                            <Border Width="72" Height="72" CornerRadius="8" Background="{StaticResource NavyBorder}">
                                <Path Data="{StaticResource IconTicket}" Fill="{StaticResource TextSecondary}" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Combo.Name}" Style="{StaticResource TextH3}" />
                                <TextBlock Text="{Binding Combo.Description}" Style="{StaticResource TextCaption}" Margin="0,2,0,6" />
                                <TextBlock Text="{Binding Combo.Price, Converter={StaticResource Money}}" Foreground="{StaticResource AccentGold}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Padding="0" Width="34" Height="34"
                                        Command="{Binding DataContext.DecreaseComboCommand, ElementName=Root}" CommandParameter="{Binding}">
                                    <Path Data="{StaticResource IconMinus}" Fill="{StaticResource TextPrimary}" Width="14" Height="14" Stretch="Uniform" />
                                </Button>
                                <TextBlock Text="{Binding Quantity}" Width="40" TextAlignment="Center" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button Style="{StaticResource PrimaryButton}" Padding="0" Width="34" Height="34"
                                        Command="{Binding DataContext.IncreaseComboCommand, ElementName=Root}" CommandParameter="{Binding}">
                                    <Path Data="{StaticResource IconPlus}" Fill="{StaticResource TextPrimary}" Width="14" Height="14" Stretch="Uniform" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
