<UserControl x:Class="CineBook.Controls.MovieShelf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CineBook.Controls"
             x:Name="Root">
    <!-- Một hàng phim cuộn ngang có nút ◀ ▶ và đủ 3 trạng thái Loading/Empty/Error -->
    <StackPanel Margin="0,12">
        <Grid Margin="40,0,40,4">
            <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource TextH2}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" Click="OnScrollLeft"><Path Data="{StaticResource IconChevronLeft}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" /></Button>
                <Button Style="{StaticResource IconButton}" Click="OnScrollRight" Margin="4,0,0,0"><Path Data="{StaticResource IconChevronRight}" Fill="{StaticResource TextPrimary}" Stretch="Uniform" /></Button>
            </StackPanel>
        </Grid>

        <ctl:StatefulContent IsLoading="{Binding Section.IsLoading, ElementName=Root}" IsEmpty="{Binding Section.IsEmpty, ElementName=Root}"
                             IsError="{Binding Section.IsError, ElementName=Root}" ErrorText="{Binding Section.Error, ElementName=Root}"
                             RetryCommand="{Binding RetryCommand, ElementName=Root}" EmptyText="Chưa có phim nào" MinHeight="330">
            <ctl:StatefulContent.Skeleton>
                <ItemsControl ItemsSource="{x:Static ctl:MovieShelf.SkeletonSlots}" Margin="32,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="170" Margin="8,12">
                                <ctl:SkeletonBox Height="255" />
                                <ctl:SkeletonBox Height="14" Margin="0,10,40,0" />
                                <ctl:SkeletonBox Height="10" Margin="0,6,70,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ctl:StatefulContent.Skeleton>

            <ScrollViewer Loaded="OnScrollerLoaded" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Padding="32,0">
                <ItemsControl ItemsSource="{Binding Section.Items, RelativeSource={RelativeSource AncestorType=ctl:MovieShelf}}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ctl:MoviePosterCard OpenCommand="{Binding OpenCommand, RelativeSource={RelativeSource AncestorType=ctl:MovieShelf}}" RemindCommand="{Binding RemindCommand, RelativeSource={RelativeSource AncestorType=ctl:MovieShelf}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </ctl:StatefulContent>
    </StackPanel>
</UserControl>
