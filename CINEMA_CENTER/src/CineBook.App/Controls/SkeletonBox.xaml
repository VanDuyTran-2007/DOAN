<UserControl x:Class="CineBook.Controls.SkeletonBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Khung xương loading với hiệu ứng shimmer: dải sáng chạy ngang qua nền navy -->
    <Border x:Name="Box" CornerRadius="8" Background="{StaticResource NavySurface}" ClipToBounds="True">
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TranslateTransform x:Name="Shift" X="-1" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#00FFFFFF" Offset="0" />
                    <GradientStop Color="#14FFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" From="-1" To="1" Duration="0:0:1.4" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</UserControl>
