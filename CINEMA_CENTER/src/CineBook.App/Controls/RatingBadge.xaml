<UserControl x:Class="CineBook.Controls.RatingBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" HorizontalAlignment="Left" VerticalAlignment="Bottom">
    <!-- Score badge: star + score on one row. Width follows the content, so "10.0" is never cut. -->
    <Border CornerRadius="6" Background="{StaticResource ScrimBrush}" Padding="8,4">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="{StaticResource IconStar}" Fill="{StaticResource AccentGold}" Width="12" Height="12"
                  Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock Text="{Binding Score, ElementName=Root, Converter={StaticResource ScoreText}}"
                       FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
