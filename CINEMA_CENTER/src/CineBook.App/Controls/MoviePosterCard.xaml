<UserControl x:Class="CineBook.Controls.MoviePosterCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CineBook.Controls"
             x:Name="Root" Width="170" Margin="8,12">
    <!-- DataContext = Movie. Hover: phóng to 1.05, đổ bóng, hiện nút hành động. -->
    <UserControl.Resources>
        <Style x:Key="CardRoot" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" /></Setter.Value></Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="CardRootBorder" Style="{StaticResource CardRoot}" RenderTransformOrigin="0.5,0.5"
            MouseLeftButtonUp="OnCardClick">
        <Border.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" /></Border.RenderTransform>
        <Border.Triggers>
            <!-- Hover: phóng to 1.05 + hiện lớp phủ nút hành động (150ms) -->
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15" />
                </Storyboard></BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                </Storyboard></BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <StackPanel>
            <!-- Poster tỉ lệ 2:3 (170 x 255) -->
            <Grid Height="255">
                <ctl:PosterView />

                <!-- Nhãn tuổi (góc trên trái) -->
                <ctl:AgeBadge Code="{Binding AgeRating}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" />

                <!-- Badge HOT -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,2" CornerRadius="999"
                        Background="{StaticResource AccentGold}" Visibility="{Binding IsHot, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="HOT" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource NavyDarkest}" />
                </Border>

                <!-- Rating (góc dưới trái) -->
                <ctl:RatingBadge Score="{Binding Rating}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                                 Visibility="{Binding HasRating, Converter={StaticResource BoolToVis}}" />

                <!-- Lớp phủ hiện khi hover: nút hành động -->
                <Border x:Name="Overlay" Opacity="0" CornerRadius="8" Background="{StaticResource ScrimBrush}">


                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Button x:Name="ActionButton" Style="{StaticResource PrimaryButton}" Padding="22,9" Click="OnActionClick" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" Margin="2,12,2,0" />
            <TextBlock Text="{Binding GenresText}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" Margin="2,2,2,0" />
            <!-- Phim sắp chiếu: hiện ngày khởi chiếu -->
            <TextBlock x:Name="ReleaseText" Style="{StaticResource TextCaption}" Foreground="{StaticResource AccentGold}" Margin="2,2,2,0" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
