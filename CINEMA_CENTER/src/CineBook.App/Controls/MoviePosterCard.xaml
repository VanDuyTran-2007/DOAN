<UserControl x:Class="CineBook.Controls.MoviePosterCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:CineBook.Controls"
             x:Name="Root" Width="170" Margin="8,12" Focusable="True" IsTabStop="True"
             AutomationProperties.Name="{Binding Title}"
             AutomationProperties.HelpText="Nhấn Enter để mở chi tiết hoặc phím cách để xem trước.">
    <!-- DataContext = Movie. CinematicPreviewHost quản lý lớp xem trước dùng chung. -->
    <UserControl.Resources>
        <Style x:Key="CardRoot" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" /></Setter.Value></Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardRoot}" MouseLeftButtonUp="OnCardClick">
        <StackPanel>
            <!-- Poster tỉ lệ 2:3 (170 x 255) -->
            <Grid x:Name="PosterAnchor" Height="255">
                <ctl:PosterView />

                <!-- Nhãn tuổi (góc trên trái) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,2" CornerRadius="999"
                        Background="{Binding AgeRating, Converter={StaticResource AgeBrush}}">
                    <TextBlock Text="{Binding AgeRating}" FontSize="11" FontWeight="Bold" />
                </Border>

                <!-- Badge HOT -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,2" CornerRadius="999"
                        Background="{StaticResource AccentGold}" Visibility="{Binding IsHot, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="HOT" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource NavyDarkest}" />
                </Border>

                <!-- Rating (góc dưới trái) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="7,3" CornerRadius="999"
                        Background="{StaticResource ScrimBrush}" Visibility="{Binding HasRating, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconStar}" Fill="{StaticResource AccentGold}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding RatingText}" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border BorderThickness="2" BorderBrush="{StaticResource AccentGold}" CornerRadius="8" IsHitTestVisible="False"
                        Visibility="{Binding IsKeyboardFocused, ElementName=Root, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="2,10,2,0" />
            <TextBlock Text="{Binding GenresText}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" Margin="2,2,2,0" />
            <!-- Phim sắp chiếu: hiện ngày khởi chiếu -->
            <TextBlock x:Name="ReleaseText" Style="{StaticResource TextCaption}" Foreground="{StaticResource AccentGold}" Margin="2,2,2,0" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
