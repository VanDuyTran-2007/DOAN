<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Màu (Color) – hậu tố "Color"; Brush dùng đúng tên trong bảng thiết kế -->
    <Color x:Key="NavyDarkestColor">#070F1F</Color>
    <Color x:Key="NavyDarkColor">#0B1A33</Color>
    <Color x:Key="NavySurfaceColor">#13264A</Color>
    <Color x:Key="NavyBorderColor">#1E3560</Color>
    <Color x:Key="BurgundyColor">#800020</Color>
    <Color x:Key="BurgundyHoverColor">#9B1B3A</Color>
    <Color x:Key="BurgundyDarkColor">#5C0A1E</Color>
    <Color x:Key="AccentGoldColor">#D4A84B</Color>
    <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
    <Color x:Key="TextSecondaryColor">#A9B4C8</Color>
    <Color x:Key="TextMutedColor">#6B7A96</Color>
    <Color x:Key="SuccessColor">#2FB67C</Color>
    <Color x:Key="ErrorColor">#E5484D</Color>

    <SolidColorBrush x:Key="NavyDarkest" Color="{StaticResource NavyDarkestColor}" />
    <SolidColorBrush x:Key="NavyDark" Color="{StaticResource NavyDarkColor}" />
    <SolidColorBrush x:Key="NavySurface" Color="{StaticResource NavySurfaceColor}" />
    <SolidColorBrush x:Key="NavyBorder" Color="{StaticResource NavyBorderColor}" />
    <SolidColorBrush x:Key="Burgundy" Color="{StaticResource BurgundyColor}" />
    <SolidColorBrush x:Key="BurgundyHover" Color="{StaticResource BurgundyHoverColor}" />
    <SolidColorBrush x:Key="BurgundyDark" Color="{StaticResource BurgundyDarkColor}" />
    <SolidColorBrush x:Key="AccentGold" Color="{StaticResource AccentGoldColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Error" Color="{StaticResource ErrorColor}" />

    <!-- Màu trong suốt dùng cho overlay / kính mờ -->
    <SolidColorBrush x:Key="GlassFill" Color="#0B1A33" Opacity="0.55" />
    <SolidColorBrush x:Key="GlassBorder" Color="#FFFFFF" Opacity="0.15" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#000000" Opacity="0.55" />

    <!-- Gradient đặc trưng: Burgundy → NavyDark theo đường chéo (banner, nút CTA lớn) -->
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BurgundyColor}" Offset="0" />
        <GradientStop Color="{StaticResource NavyDarkColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- Bo góc thống nhất -->
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusInput">6</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
</ResourceDictionary>
