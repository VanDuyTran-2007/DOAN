<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Font: Segoe UI Variable, nếu máy không có sẽ rơi về Segoe UI -->
    <FontFamily x:Key="AppFont">Segoe UI Variable, Segoe UI</FontFamily>

    <Style x:Key="TextBase" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="TextH1" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="TextH2" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TextH3" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TextBody" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextSecondaryBody" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
    <Style x:Key="TextCaption" TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>
    <Style x:Key="TextError" TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
        <Setter Property="Foreground" Value="{StaticResource Error}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Mặc định cho mọi TextBlock không gán style -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}" />
</ResourceDictionary>
