<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<AssemblyName>CineBook.Api</AssemblyName>
		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>
	<PropertyGroup>
		<LangVersion>14.0</LangVersion>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
	</PropertyGroup>
	<PropertyGroup />
	<ItemGroup />
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<Reference Include="Microsoft.EntityFrameworkCore">
			<HintPath>bin\Debug\net10.0\Microsoft.EntityFrameworkCore.dll</HintPath>
		</Reference>
		<Reference Include="Microsoft.AspNetCore.OpenApi">
			<HintPath>bin\Debug\net10.0\Microsoft.AspNetCore.OpenApi.dll</HintPath>
		</Reference>
		<Reference Include="Microsoft.OpenApi">
			<HintPath>bin\Debug\net10.0\Microsoft.OpenApi.dll</HintPath>
		</Reference>
		<Reference Include="Microsoft.EntityFrameworkCore.SqlServer">
			<HintPath>bin\Debug\net10.0\Microsoft.EntityFrameworkCore.SqlServer.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<Compile Include="..\CineBook.App\Models\Entities.cs" Link="DemoData\Entities.cs" />
		<Compile Include="..\CineBook.App\Models\Enums.cs" Link="DemoData\Enums.cs" />
		<Compile Include="..\CineBook.App\Services\Mock\MockData.cs" Link="DemoData\MockData.cs" />
	</ItemGroup>
</Project>
