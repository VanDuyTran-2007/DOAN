<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<AssemblyName>CineBook.Api</AssemblyName>
		<UserSecretsId>CineBook.Api-Development</UserSecretsId>
		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>
	<PropertyGroup>
		<LangVersion>14.0</LangVersion>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
	</PropertyGroup>
	<PropertyGroup />
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<Compile Include="..\CineBook.App\Models\Entities.cs" Link="DemoData\Entities.cs" />
		<Compile Include="..\CineBook.App\Models\Enums.cs" Link="DemoData\Enums.cs" />
		<Compile Include="..\CineBook.App\Models\MemberPricing.cs" Link="DemoData\MemberPricing.cs" />
		<Compile Include="..\CineBook.App\Services\Mock\MockData.cs" Link="DemoData\MockData.cs" />
	</ItemGroup>
</Project>
