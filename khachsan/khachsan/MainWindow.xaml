<Window x:Class="khachsan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:khachsan"
        mc:Ignorable="d"
        Title="MainWindow" Height="540" Width="960">
    <Viewbox Stretch="Fill">
        <Grid Width="960" Height="540">
            <Image Source="/Images/khachsan.jpg" Stretch="Fill" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1"
                    Margin="0,30,35,30"
                    Padding="28,22"
                    CornerRadius="20"
                    Background="#D9FFFFFF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <!-- Hàng 0: Logo -->
                        <Image Grid.Row="0" Grid.ColumnSpan="2"
                           Source="/Images/logo.jpg"
                           Height="50"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,10" />
                        <!-- Hàng 1: Tiêu đề -->
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                               Text="ĐĂNG NHẬP"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               TextAlignment="Center"
                               Margin="0,0,0,16" />
                        <!-- Hàng 2: Tài khoản -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Tài khoản:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               VerticalAlignment="Center"
                               Margin="0,0,10,6" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                             x:Name="txtTaiKhoan"
                             Height="36"
                             FontSize="14"
                             Padding="8,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#94A3B8"
                             BorderThickness="1"
                             Margin="0,0,0,6">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <!-- Hàng 3: Khung báo lỗi Tài khoản -->
                        <Border Grid.Row="3" Grid.ColumnSpan="2"
                            x:Name="borderThongBaoLoi1"
                            Background="#FEE2E2"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="⚠ "
                                       Foreground="#DC2626"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                                <TextBlock x:Name="txtThongBaoLoi1"
                                       Text="Tài khoản không tồn tại hoặc chưa đúng!"
                                       Foreground="#B91C1C"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- Hàng 4: Mật khẩu -->
                        <TextBlock Grid.Row="4" Grid.Column="0"
                               Text="Mật khẩu:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               VerticalAlignment="Center"
                               Margin="0,0,10,6" />
                        <Border Grid.Row="4" Grid.Column="1"
                            Height="36"
                            CornerRadius="8"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            Background="White"
                            Margin="0,0,0,6">
                            <PasswordBox x:Name="txtMatKhau"
                                     FontSize="14"
                                     Padding="8,0"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0"
                                     Background="Transparent" />
                        </Border>
                        <!-- Hàng 5: Khung báo lỗi Mật khẩu (đồng bộ kiểu dáng với Hàng 3) -->
                        <Border Grid.Row="5" Grid.ColumnSpan="2"
                            x:Name="borderThongBaoLoi2"
                            Background="#FEE2E2"
                            BorderBrush="#FCA5A5"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="⚠ "
                                       Foreground="#DC2626"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                                <TextBlock x:Name="txtThongBaoLoi2"
                                       Text="Mật khẩu chưa đúng!"
                                       Foreground="#B91C1C"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- Hàng 6: Nút Đăng nhập -->
                        <Button Grid.Row="6" Grid.ColumnSpan="2"
                            x:Name="btnDangNhap"
                            Content="Đăng nhập"
                            Height="40"
                            FontSize="14"
                            FontWeight="Bold"
                            Background="#0284C7"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,6,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <!-- Hàng 7: Dòng chuyển sang Đăng ký -->
                        <StackPanel Grid.Row="7" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">
                            <TextBlock Text="Chưa có tài khoản? "
                                   FontSize="13"
                                   Foreground="#475569" />
                            <TextBlock x:Name="txtDangKy"
                                   Text="Đăng ký ngay"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#0284C7"
                                   TextDecorations="Underline"
                                   Cursor="Hand" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
