<Page x:Class="DOAN.Pages.RoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fx="clr-namespace:DOAN.Helpers"
      Title="Phòng nghỉ" Background="{StaticResource CreamBrush}">

    <ScrollViewer x:Name="Scroller" CanContentScroll="False" VerticalScrollBarVisibility="Auto"
                  ScrollChanged="Scroller_ScrollChanged">
        <StackPanel RequestBringIntoView="NoAutoScroll">

            <!-- ============================ BANNER ============================ -->
            <Grid Height="380" ClipToBounds="True" Background="{StaticResource ForestDarkBrush}">
                <Image x:Name="BannerImage" Stretch="UniformToFill" />
                <Border Background="{StaticResource BannerOverlay}" />
                <StackPanel VerticalAlignment="Bottom" Margin="96,0,96,110">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Trang chủ" Style="{StaticResource FooterLink}" Margin="0" FontSize="13" Click="Home_Click" />
                        <TextBlock Text="  /  Phòng nghỉ" Foreground="{StaticResource BrassBrush}" FontSize="13" />
                    </StackPanel>
                    <TextBlock Text="Phòng nghỉ &amp; Villa" Style="{StaticResource H1}" FontSize="58" />
                    <TextBlock Text="6 hạng phòng cho mọi nhu cầu – từ chuyến công tác một đêm đến lưu trú dài hạn cùng gia đình."
                               Style="{StaticResource Body}" Foreground="{StaticResource WhiteSoftBrush}" FontSize="16" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>

            <!-- ============================ BỘ LỌC ============================ -->
            <Border Style="{StaticResource Card}" Margin="96,-70,96,0" Padding="28,22" MaxWidth="1240">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="TÌM HẠNG PHÒNG" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <TextBox Style="{StaticResource InputBox}" Padding="34,0,10,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="NHẬN PHÒNG" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding CheckIn, Mode=TwoWay}" DisplayDateStart="{Binding Today, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="TRẢ PHÒNG" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding CheckOut, Mode=TwoWay}" DisplayDateStart="{Binding MinCheckOut, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="SỐ KHÁCH" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding GuestOptions}" SelectedItem="{Binding Guests}" />
                        </StackPanel>
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="TRẠNG THÁI" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedIndex="{Binding StatusIndex}" />
                        </StackPanel>
                        <StackPanel Grid.Column="10">
                            <TextBlock Text="SẮP XẾP" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20,0,14" />
                    <Grid>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Small}" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Còn trống" Style="{StaticResource Small}" Margin="6,0,18,0" />
                            <Ellipse Width="9" Height="9" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Sắp hết" Style="{StaticResource Small}" Margin="6,0,18,0" />
                            <Ellipse Width="9" Height="9" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Hết phòng" Style="{StaticResource Small}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======================== DANH SÁCH PHÒNG ======================== -->
            <StackPanel Margin="96,44,96,100" MaxWidth="1240">

                <!-- Không có kết quả -->
                <Border Style="{StaticResource Card}" Padding="40" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="36" Foreground="{StaticResource BrassBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Không tìm thấy hạng phòng phù hợp" Style="{StaticResource H3}" Margin="0,16,0,6" HorizontalAlignment="Center" />
                        <TextBlock Text="Hãy thử đổi ngày, giảm số khách hoặc bỏ bớt bộ lọc." Style="{StaticResource Small}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Style="{StaticResource HoverCard}" Margin="0,0,0,26" Height="300"
                                    MouseLeftButtonUp="Room_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="420" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="270" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Ảnh -->
                                    <Grid ClipToBounds="True" Background="{StaticResource SandBrush}">
                                        <Image x:Name="Photo" Source="{Binding Type.Cover, Converter={StaticResource Img}, ConverterParameter=900}"
                                               Stretch="UniformToFill" fx:Fx.HoverZoom="1.06" />
                                        <Border Background="{StaticResource BrassBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="18" Padding="12,5"
                                                Visibility="{Binding Type.HasHighlight, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Type.Highlight}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <Border x:Name="SoldOutVeil" Background="#99101A14" Visibility="Collapsed">
                                            <TextBlock Text="HẾT PHÒNG" Foreground="White" FontFamily="{StaticResource SerifFont}" FontSize="26"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Thông tin -->
                                    <StackPanel Grid.Column="1" Margin="34,30,24,26">
                                        <TextBlock Text="{Binding Type.Category}" Style="{StaticResource Eyebrow}" FontSize="11" />
                                        <TextBlock Text="{Binding Type.Name}" Style="{StaticResource H3}" FontSize="26" Margin="0,8,0,10" />
                                        <TextBlock Text="{Binding Type.ShortDescription}" Style="{StaticResource Small}" FontSize="14"
                                                   MaxHeight="40" TextTrimming="CharacterEllipsis" />

                                        <WrapPanel Margin="0,20,0,16">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                                                <Path Data="{StaticResource IconBed}" Style="{StaticResource IconPath}" />
                                                <TextBlock Text="{Binding Type.BedType}" Style="{StaticResource Small}" Foreground="{StaticResource InkBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                                                <Path Data="{StaticResource IconGuests}" Style="{StaticResource IconPath}" />
                                                <TextBlock Text="{Binding Type.GuestsText}" Style="{StaticResource Small}" Foreground="{StaticResource InkBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                                                <Path Data="{StaticResource IconArea}" Style="{StaticResource IconPath}" Width="15" Height="15" />
                                                <TextBlock Text="{Binding Type.AreaText}" Style="{StaticResource Small}" Foreground="{StaticResource InkBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                                                <Path Data="{StaticResource IconView}" Style="{StaticResource IconPath}" />
                                                <TextBlock Text="{Binding Type.View}" Style="{StaticResource Small}" Foreground="{StaticResource InkBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </WrapPanel>

                                        <ItemsControl ItemsSource="{Binding Type.TopAmenities}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Chip}" Padding="10,4">
                                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Giá + trạng thái -->
                                    <Border Grid.Column="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="28,30">
                                        <DockPanel>
                                            <Border x:Name="StatusBadge" DockPanel.Dock="Top" HorizontalAlignment="Left" CornerRadius="14" Padding="12,5"
                                                    Background="{StaticResource SuccessBgBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="StatusLabel" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource SuccessBrush}" Margin="7,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding AvailabilityText}" Style="{StaticResource Small}" Margin="2,8,0,0" />

                                            <Button DockPanel.Dock="Bottom" Content="XEM CHI TIẾT" Style="{StaticResource DarkButton}"
                                                    Padding="0,13" Click="Detail_Click" />
                                            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,18">
                                                <TextBlock Text="Giá mỗi đêm từ" Style="{StaticResource Small}" />
                                                <TextBlock Text="{Binding Type.PriceText}" FontFamily="{StaticResource SerifFont}" FontSize="30"
                                                           Foreground="{StaticResource InkBrush}" />
                                            </StackPanel>
                                            <Border />
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFew}" Value="True">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource WarningBgBrush}" />
                                    <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource WarningBrush}" />
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter TargetName="StatusBadge" Property="Background" Value="{StaticResource DangerBgBrush}" />
                                    <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource DangerBrush}" />
                                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    <Setter TargetName="SoldOutVeil" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
