<Page x:Class="DOAN.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:fx="clr-namespace:DOAN.Helpers"
      Title="Trang chủ" Background="{StaticResource CreamBrush}">

    <ScrollViewer x:Name="Scroller" CanContentScroll="False" VerticalScrollBarVisibility="Auto"
                  ScrollChanged="Scroller_ScrollChanged">
        <StackPanel x:Name="Root">

            <!-- ============================ HERO ============================ -->
            <Grid x:Name="Hero" MinHeight="700" ClipToBounds="True"
                  Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Frame}}">
                <Grid Background="{StaticResource ForestDarkBrush}" />
                <Image x:Name="HeroA" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5" />
                <Image x:Name="HeroB" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5" Opacity="0" />
                <Border Background="{StaticResource HeroOverlay}" />

                <Grid Margin="96,0,96,150">
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="820">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <Border Width="40" Height="1" Background="{StaticResource BrassBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="LÀNG ĐẠI HỌC  ·  THỦ ĐỨC  ·  TP. HỒ CHÍ MINH" Style="{StaticResource Eyebrow}"
                                       Margin="14,0,0,0" FontSize="13" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource H1}" FontSize="76" LineHeight="84">
                            <Run Text="Bình yên giữa" /><LineBreak /><Run Text="lòng làng đại học" FontStyle="Italic" />
                        </TextBlock>
                        <TextBlock Text="Villa ĐHQG – không gian lưu trú xanh dành cho giảng viên, chuyên gia, khách mời và gia đình sinh viên. Thức dậy giữa rừng cây, chỉ vài phút đến các trường thành viên."
                                   Style="{StaticResource Body}" Foreground="{StaticResource WhiteSoftBrush}"
                                   FontSize="17" LineHeight="28" Margin="0,24,0,34" MaxWidth="620" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="KHÁM PHÁ PHÒNG NGHỈ" Style="{StaticResource PrimaryButton}" Click="ExploreRooms_Click" />
                            <Button Content="VỀ CHÚNG TÔI" Style="{StaticResource OutlineLightButton}" Margin="14,0,0,0"
                                    Click="About_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Điều khiển slideshow -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                        <TextBlock x:Name="SlideCounter" Text="01 / 03" Foreground="White" FontFamily="{StaticResource SerifFont}"
                                   FontSize="18" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <Button Content="&#xE76B;" Style="{StaticResource RoundButton}" Click="PrevSlide_Click" />
                        <Button Content="&#xE76C;" Style="{StaticResource RoundButton}" Margin="10,0,0,0" Click="NextSlide_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ======================= THANH TÌM PHÒNG ======================= -->
            <Border Style="{StaticResource Card}" Margin="96,-82,96,0" Padding="30,24" MaxWidth="1180">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="NGÀY NHẬN PHÒNG" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="CheckInPicker" SelectedDateChanged="CheckIn_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="NGÀY TRẢ PHÒNG" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="CheckOutPicker" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="SỐ KHÁCH" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="GuestsBox" />
                    </StackPanel>
                    <Button Grid.Column="6" Content="KIỂM TRA PHÒNG TRỐNG" Style="{StaticResource DarkButton}"
                            VerticalAlignment="Bottom" Height="44" Padding="28,0" Click="CheckAvailability_Click" />
                </Grid>
            </Border>

            <!-- ========================== GIỚI THIỆU ========================== -->
            <Grid x:Name="AboutSection" Margin="96,110,96,110" MaxWidth="1240">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="1.05*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="VỀ VILLA ĐHQG" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="Một nơi để nghỉ ngơi, gặp gỡ và truyền cảm hứng" Style="{StaticResource H2}" Margin="0,16,0,24" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,16"
                               Text="Lấy cảm hứng từ Nhà khách Đại học Quốc gia TP.HCM, Villa ĐHQG là điểm lưu trú nằm giữa khu đô thị đại học rộng lớn ở Thủ Đức – nơi những hàng cây dầu, hồ nước và các giảng đường hòa vào nhau." />
                    <TextBlock Style="{StaticResource Body}"
                               Text="Chúng tôi phục vụ khách tham dự hội thảo, chuyên gia quốc tế, đoàn sinh viên và phụ huynh với hệ thống phòng đa dạng: từ phòng tiêu chuẩn tiện nghi, phòng gia đình rộng rãi đến villa sân vườn nguyên căn." />

                    <UniformGrid Columns="3" Margin="0,40,0,40">
                        <StackPanel>
                            <TextBlock x:Name="StatRooms" Text="36" FontFamily="{StaticResource SerifFont}" FontSize="44" Foreground="{StaticResource ForestBrush}" />
                            <TextBlock Text="Phòng &amp; villa" Style="{StaticResource Small}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="StatTypes" Text="7" FontFamily="{StaticResource SerifFont}" FontSize="44" Foreground="{StaticResource ForestBrush}" />
                            <TextBlock Text="Hạng phòng" Style="{StaticResource Small}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="2 ha" FontFamily="{StaticResource SerifFont}" FontSize="44" Foreground="{StaticResource ForestBrush}" />
                            <TextBlock Text="Khuôn viên xanh" Style="{StaticResource Small}" />
                        </StackPanel>
                    </UniformGrid>

                    <Button Content="XEM CÁC HẠNG PHÒNG  →" Style="{StaticResource OutlineDarkButton}" HorizontalAlignment="Left"
                            Click="ExploreRooms_Click" />
                </StackPanel>

                <!-- Ảnh ghép -->
                <Grid Grid.Column="2" Height="600">
                    <Border Margin="0,0,90,90" ClipToBounds="True" Background="{StaticResource SandBrush}">
                        <Image Source="{Binding Gallery[4].Url, Converter={StaticResource Img}, ConverterParameter=1200}"
                               Stretch="UniformToFill" fx:Fx.HoverZoom="1.05" />
                    </Border>
                    <Border Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            BorderBrush="{StaticResource CreamBrush}" BorderThickness="10" Background="{StaticResource SandBrush}"
                            ClipToBounds="True">
                        <Image Source="{Binding Gallery[3].Url, Converter={StaticResource Img}, ConverterParameter=700}"
                               Stretch="UniformToFill" fx:Fx.HoverZoom="1.06" />
                    </Border>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{StaticResource ForestBrush}"
                            Padding="26,20" Margin="-30,0,0,30">
                        <StackPanel>
                            <TextBlock Text="Từ 450.000 đ" FontFamily="{StaticResource SerifFont}" FontSize="26" Foreground="White" />
                            <TextBlock Text="mỗi đêm, đã gồm thuế phí" Style="{StaticResource Small}" Foreground="{StaticResource WhiteSoftBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- =========================== TIỆN ÍCH =========================== -->
            <Border x:Name="AmenitiesSection" Background="{StaticResource ForestDarkBrush}" Padding="96,100">
                <StackPanel MaxWidth="1240">
                    <Grid Margin="0,0,0,48">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="TIỆN ÍCH &amp; DỊCH VỤ" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="Mọi thứ cho một kỳ lưu trú trọn vẹn" Style="{StaticResource H2}" Foreground="White" Margin="0,14,0,0" />
                        </StackPanel>
                        <TextBlock Text="Từ bữa sáng bên hồ đến phòng hội thảo cho 200 khách – chúng tôi chuẩn bị chu đáo để bạn chỉ cần tận hưởng."
                                   Style="{StaticResource Body}" Foreground="{StaticResource WhiteSoftBrush}" MaxWidth="400"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Features}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,24,0">
                                    <Border Height="320" ClipToBounds="True" Background="{StaticResource ForestBrush}">
                                        <Image Source="{Binding Url, Converter={StaticResource Img}, ConverterParameter=700}"
                                               Stretch="UniformToFill" fx:Fx.HoverZoom="1.08" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Eyebrow}" FontSize="13" Margin="0,22,0,8" />
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" Foreground="{StaticResource WhiteSoftBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{StaticResource WhiteLineBrush}" Margin="0,64,0,44" />

                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                    <Border Width="46" Height="46" CornerRadius="23" BorderBrush="{StaticResource BrassBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="17"
                                                   Foreground="{StaticResource BrassBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource Small}" Foreground="{StaticResource WhiteSoftBrush}" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ========================= PHÒNG NỔI BẬT ========================= -->
            <StackPanel Margin="96,110,96,100" MaxWidth="1240">
                <Grid Margin="0,0,0,44">
                    <StackPanel>
                        <TextBlock Text="PHÒNG NGHỈ" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="Lựa chọn hạng phòng phù hợp với bạn" Style="{StaticResource H2}" Margin="0,14,0,0" />
                    </StackPanel>
                    <Button Content="XEM TẤT CẢ PHÒNG  →" Style="{StaticResource OutlineDarkButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="ExploreRooms_Click" />
                </Grid>

                <ItemsControl ItemsSource="{Binding FeaturedRooms}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HoverCard}" Margin="0,0,26,0" fx:Fx.HoverLift="True"
                                    MouseLeftButtonUp="Room_Click">
                                <StackPanel>
                                    <Grid Height="280" ClipToBounds="True" Background="{StaticResource SandBrush}">
                                        <Image Source="{Binding Cover, Converter={StaticResource Img}, ConverterParameter=800}"
                                               Stretch="UniformToFill" fx:Fx.HoverZoom="1.06" />
                                        <Border Background="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Padding="12,6">
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource Eyebrow}" FontSize="11" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Margin="26,24,26,26">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" />
                                        <TextBlock Text="{Binding ShortDescription}" Style="{StaticResource Small}" Margin="0,10,0,18"
                                                   Height="40" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconBed}" Style="{StaticResource IconPath}" />
                                            <TextBlock Text="{Binding BedsText}" Style="{StaticResource Small}" Margin="6,0,16,0" VerticalAlignment="Center" />
                                            <Path Data="{StaticResource IconGuests}" Style="{StaticResource IconPath}" />
                                            <TextBlock Text="{Binding MaxGuests, StringFormat={}{0} khách}" Style="{StaticResource Small}" Margin="6,0,16,0" VerticalAlignment="Center" />
                                            <Path Data="{StaticResource IconArea}" Style="{StaticResource IconPath}" Width="15" Height="15" />
                                            <TextBlock Text="{Binding AreaText}" Style="{StaticResource Small}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,20" />
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding PriceText}" FontFamily="{StaticResource SerifFont}" FontSize="22"
                                                           Foreground="{StaticResource InkBrush}" />
                                                <TextBlock Text=" / đêm" Style="{StaticResource Small}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                            </StackPanel>
                                            <TextBlock Text="Chi tiết  →" Foreground="{StaticResource BrassBrush}" FontWeight="SemiBold"
                                                       FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ========================== THƯ VIỆN ẢNH ========================== -->
            <StackPanel x:Name="GallerySection" Margin="96,0,96,110" MaxWidth="1240">
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,44">
                    <TextBlock Text="THƯ VIỆN ẢNH" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center" />
                    <TextBlock Text="Khoảnh khắc tại Villa ĐHQG" Style="{StaticResource H2}" Margin="0,14,0,0" TextAlignment="Center" />
                </StackPanel>

                <Grid Height="620">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <!-- Một ô ảnh: hover sẽ phóng to và hiện chú thích -->
                        <DataTemplate x:Key="Tile">
                            <Grid ClipToBounds="True" Background="{StaticResource SandBrush}" Margin="8">
                                <Image Source="{Binding Url, Converter={StaticResource Img}, ConverterParameter=1000}"
                                       Stretch="UniformToFill" fx:Fx.HoverZoom="1.08" />
                                <Border x:Name="Cap" VerticalAlignment="Bottom" Padding="20,40,20,18" Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#CC000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Caption}" Foreground="White" FontFamily="{StaticResource SerifFont}" FontSize="20" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Cap" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </Grid.Resources>
                    <ContentControl Grid.RowSpan="2" Content="{Binding Gallery[0]}" ContentTemplate="{StaticResource Tile}" Margin="-8,-8,0,-8" />
                    <ContentControl Grid.Column="1" Content="{Binding Gallery[1]}" ContentTemplate="{StaticResource Tile}" Margin="0,-8,0,0" />
                    <ContentControl Grid.Column="2" Content="{Binding Gallery[2]}" ContentTemplate="{StaticResource Tile}" Margin="0,-8,-8,0" />
                    <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding Gallery[5]}" ContentTemplate="{StaticResource Tile}" Margin="0,0,0,-8" />
                    <ContentControl Grid.Column="2" Grid.Row="1" Content="{Binding Gallery[3]}" ContentTemplate="{StaticResource Tile}" Margin="0,0,-8,-8" />
                </Grid>
            </StackPanel>

            <!-- ============================ KÊU GỌI ĐẶT PHÒNG ============================ -->
            <Grid Height="420" ClipToBounds="True">
                <Image Source="{Binding HeroImages[2], Converter={StaticResource Img}, ConverterParameter=1920}" Stretch="UniformToFill" />
                <Border Background="#B3101A14" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
                    <TextBlock Text="ƯU ĐÃI ĐẶT TRỰC TIẾP" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center" />
                    <TextBlock Text="Giảm 10% cho cán bộ, giảng viên và đoàn sinh viên ĐHQG-HCM" Style="{StaticResource H2}"
                               Foreground="White" TextAlignment="Center" Margin="0,16,0,30" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="ĐẶT PHÒNG NGAY" Style="{StaticResource PrimaryButton}" Click="ExploreRooms_Click" />
                        <Button x:Name="CallButton" Style="{StaticResource OutlineLightButton}" Margin="14,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============================== FOOTER ============================== -->
            <Border x:Name="ContactSection" Background="{StaticResource ForestDarkBrush}" Padding="96,80,96,30">
                <StackPanel MaxWidth="1240">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,60,0">
                            <TextBlock Text="VILLA ĐHQG" FontFamily="{StaticResource SerifFont}" FontSize="28" Foreground="White" />
                            <TextBlock Text="Nhà khách – nghỉ dưỡng giữa lòng Làng Đại học. Dự án học tập mô phỏng, lấy cảm hứng từ Nhà khách ĐHQG-HCM."
                                       Style="{StaticResource Body}" Foreground="{StaticResource WhiteSoftBrush}" Margin="0,16,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,40,0">
                            <TextBlock Text="LIÊN HỆ" Style="{StaticResource Eyebrow}" Margin="0,0,0,20" />
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock Text="&#xE81D;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource BrassBrush}" Margin="0,3,12,0" />
                                <TextBlock x:Name="AddressText" Style="{StaticResource Body}" Foreground="{StaticResource WhiteSoftBrush}" FontSize="14" />
                            </DockPanel>
                            <DockPanel Margin="0,0,0,14">
                                <TextBlock Text="&#xE717;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource BrassBrush}" Margin="0,3,12,0" />
                                <TextBlock x:Name="PhoneText" Style="{StaticResource Body}" Foreground="{StaticResource WhiteSoftBrush}" FontSize="14" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="&#xE715;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource BrassBrush}" Margin="0,3,12,0" />
                                <TextBlock x:Name="EmailText" Style="{StaticResource Body}" Foreground="{StaticResource WhiteSoftBrush}" FontSize="14" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="KHÁM PHÁ" Style="{StaticResource Eyebrow}" Margin="0,0,0,20" />
                            <Button Content="Phòng nghỉ" Style="{StaticResource FooterLink}" Click="ExploreRooms_Click" />
                            <Button Content="Giới thiệu" Style="{StaticResource FooterLink}" Click="About_Click" />
                            <Button Content="Tiện ích" Style="{StaticResource FooterLink}" Click="Amenities_Click" />
                            <Button Content="Thư viện ảnh" Style="{StaticResource FooterLink}" Click="Gallery_Click" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="THÔNG TIN LƯU TRÚ" Style="{StaticResource Eyebrow}" Margin="0,0,0,20" />
                            <TextBlock Text="Nhận phòng: từ 14:00" Style="{StaticResource Body}" Foreground="{StaticResource WhiteSoftBrush}" FontSize="14" />
                            <TextBlock Text="Trả phòng: trước 12:00" Style="{StaticResource Body}" Foreground="{StaticResource WhiteSoftBrush}" FontSize="14" />
                            <TextBlock Text="Lễ tân: 24/7" Style="{StaticResource Body}" Foreground="{StaticResource WhiteSoftBrush}" FontSize="14" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{StaticResource WhiteLineBrush}" Margin="0,60,0,24" />
                    <Grid>
                        <TextBlock Text="© 2026 Villa ĐHQG. Đồ án môn học – Lập trình trực quan." Style="{StaticResource Small}"
                                   Foreground="#80FFFFFF" />
                        <Button Content="Lên đầu trang  ↑" Style="{StaticResource FooterLink}" Margin="0" HorizontalAlignment="Right"
                                FontSize="13" Click="Top_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
